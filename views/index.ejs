<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Simple Blog</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        background: #f9f9f9;
      }
      .navbar {
        background: #333;
        padding: 1em 0;
        display: flex;
        justify-content: center;
      }
      .navbar a {
        color: #fff;
        text-decoration: none;
        margin: 0 1.5em;
        font-weight: bold;
        transition: color 0.2s;
      }
      .navbar a:hover {
        color: #ffd700;
      }
      .container {
        max-width: 800px;
        margin: 2em auto;
        background: #fff;
        padding: 2em;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
      }
      .post {
        border-bottom: 1px solid #eee;
        padding-bottom: 1em;
        margin-bottom: 1em;
      }
      .post:last-child {
        border-bottom: none;
      }
      .post-title {
        font-size: 1.4em;
        margin: 0 0 0.5em 0;
      }
      .post-content {
        margin: 0;
      }
      .form-group {
        margin-bottom: 1em;
      }
      input,
      textarea {
        width: 100%;
        padding: 0.7em;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 1em;
      }
      button {
        background: #333;
        color: #fff;
        border: none;
        padding: 0.7em 1.5em;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1em;
      }
      button:hover {
        background: #ffd700;
        color: #333;
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <a href="/">Home</a>
      <a href="/news">News</a>
      <a href="/about">About</a>
      <a href="/band-generator">Band Generator Project</a>
    </nav>
    <div class="container">
      <% if (page === 'home') { %>
      <h1>Welcome to the Simple Blog!</h1>
      <form id="add-post-form" action="/add-post" method="POST">
        <div class="form-group">
          <input type="text" name="title" placeholder="Post Title" required />
        </div>
        <div class="form-group">
          <textarea
            name="content"
            rows="4"
            placeholder="Write your post here..."
            required
          ></textarea>
        </div>
        <button type="submit">Add Post</button>
      </form>
      <hr />
      <h2>Recent Posts</h2>
      <% if (posts && posts.length > 0) { %> <% posts.forEach(function(post) {
      %>
      <div >
        <div class="post-title"><%= post.title %></div>
        <p class="post-content"><%= post.content %></p>
        <form
          action="/delete-post/<%= post.id %>"
          style="display: inline"
          onsubmit="event.preventDefault(); fetch(this.action, { method: 'PUT' }).then(() => location.reload());"
        >
          <button
            type="submit"
            onclick="return confirm('Are you sure you want to delete this post?')"
          >
            Delete
          </button>
        </form>
      </div>
      <% }) %> <% } else { %>
      <p>No posts yet. Be the first to write!</p>
      <% } %> <% } else if (page === 'news') { %>
      <h1>Blog News</h1>
      <p>Ini adalah contoh paging berita</p>
      <% } else if (page === 'about') { %>
      <h1>About This Blog</h1>
      <p>
        Ini adalah Web blog sederhana yang dibangun dengan Node.js, Express.js,
        dan EJS. Dapat membuat dan melihat posting, tetapi posting tidak akan
        bertahan setelah restart server.
      </p>
      <% } %>
    </div>
  </body>

  <script>
    const addForm = document.getElementById("add-post-form");

    addForm.addEventListener("submit", function (event) {
      event.preventDefault();

      const formData = new FormData(this);

      fetch("/add-post", {
        method: "POST",
        body: new URLSearchParams(formData), 
      })
        .then((response) => response.json())
        .then((data) => {
          console.log(data.message); 
          location.reload();
        })
        .catch((error) => console.error("Error:", error));
    });
  </script>
</html>
